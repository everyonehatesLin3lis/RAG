# Copy to backend/.env and fill in. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=xiaomi/mimo-v2.6-flash
# Optional: a different (faster) model for the query-translation step; empty = OPENROUTER_MODEL.
QUERY_TRANSLATION_MODEL=google/gemini-3.1-flash-lite
# Local Docker database (password = POSTGRES_PASSWORD from the repo-root .env).
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and hangs on Docker's IPv4-only port.
DATABASE_URL=postgresql+psycopg://movie_copilot:<password>@127.0.0.1:5433/movie_copilot
# Embeddings go through OpenRouter too; leave empty to reuse OPENROUTER_API_KEY.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
# Tools (Phase 24): mcp = through the MCP server (default), local = in-process
TOOL_BACKEND=mcp
# Error handling (Phase 27): time limit for answering one question, in seconds
CHAT_TIMEOUT_S=90
# Logging (Phase 15): default logs/requests.jsonl; "stdout" prints the lines (the Cloud Run setting)
# REQUEST_LOG_PATH=
# Public deployment only (app/rate_limit.py, docs/deployment.md); 0 or unset = no limit
# RATE_LIMIT_PER_MINUTE=0
# RATE_LIMIT_PER_DAY=0
