# Copy to backend/.env and fill in. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=xiaomi/mimo-v2.6-flash
# Optional: a different (faster) model for the query-translation step; empty = OPENROUTER_MODEL.
QUERY_TRANSLATION_MODEL=
# Local Docker database (password = POSTGRES_PASSWORD from the repo-root .env).
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and hangs on Docker's IPv4-only port.
DATABASE_URL=postgresql+psycopg://movie_copilot:<password>@127.0.0.1:5433/movie_copilot
# Embeddings go through OpenRouter too; leave empty to reuse OPENROUTER_API_KEY.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
# Later (Phase 22)
GOOGLE_CLOUD_PROJECT=
